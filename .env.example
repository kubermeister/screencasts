# Copy to .env (git-ignored) and fill in what you need. A variable set in the shell wins over this
# file. Every entry is optional.

# Voice providers, for scripts whose voice.provider is openai or elevenlabs. Kokoro needs no key.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# The app checkout to film, as an absolute path. Default: ../kubermeister next to this repository.
# KUBERMEISTER_APP=/Users/you/Projects/Kubermeister/kubermeister

# The chrome-headless-shell Remotion renders with. Default: the newest one Playwright installed.
# KM_SCREENCASTS_BROWSER=

# 1 removes the kept demo cluster and seeds a new one on the next run.
# KM_SCREENCASTS_FRESH=1

# 1 prints the stack trace with a failure.
# KM_SCREENCASTS_DEBUG=1
