{
  "font": {
    "family": "Geist",
    "files": ["fonts/geist-latin-wght-normal.woff2", "fonts/geist-latin-ext-wght-normal.woff2"]
  },
  "themes": {
    "dark": {
      "background": "#0b0d10",
      "surface": "#14171c",
      "text": "#eef0f4",
      "muted": "#b7bcc6",
      "accent": "#5b7cff",
      "accentStrong": "#3d5bd6",
      "border": "#353a43",
      "callout": "#5b7cff",
      "calloutText": "#ffffff"
    },
    "light": {
      "background": "#f7f7f4",
      "surface": "#ffffff",
      "text": "#18181b",
      "muted": "#3f3f46",
      "accent": "#3d5bd6",
      "accentStrong": "#2a45b0",
      "border": "#cfcfc9",
      "callout": "#3d5bd6",
      "calloutText": "#ffffff"
    }
  },
  "sizes": {
    "title": 76,
    "caption": 44,
    "callout": 34,
    "endCard": 56,
    "reelText": 60,
