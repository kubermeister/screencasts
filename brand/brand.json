    "stage": [540, 1920],
    "visibleBottom": 1600,
    "sideMargin": 64,
    "minCropWidth": 420,
    "cursorCropWidth": 560,
    "anchorPadding": 60
  },
  "durations": {
    "fadeMs": 250,
    "endCardMs": 2500,
    "zoomEaseMs": 400,
    "calloutFollowMs": 150
  }
}
